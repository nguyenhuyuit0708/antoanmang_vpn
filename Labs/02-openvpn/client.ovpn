# OpenVPN Client - Dung cho ca Windows (OpenVPN GUI) va Linux
client
dev tun
proto udp

# Thay <SERVER_IP> bang IP may chu (vd: 127.0.0.1 neu chay Docker tren cung may Windows, hoac IP VM Ubuntu)
remote 127.0.0.1 1194
resolv-retry infinite
nobind
persist-key
persist-tun

ca keys/ca.crt
cert keys/client1.crt
key keys/client1.key
tls-auth keys/ta.key 1
remote-cert-tls server

data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
auth SHA256
tls-version-min 1.2
verb 3
